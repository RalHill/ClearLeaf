# === NEON / VERCEL POSTGRES (@vercel/postgres) ===
# Paste your Neon pooled connection string (SSL required).
POSTGRES_URL=
# Optional alias — some tools expect DATABASE_URL
DATABASE_URL=

# === AUTH (NextAuth.js v5) ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=

# === OPENROUTER (AI) ===
OPENROUTER_API_KEY=

# === STRIPE ===
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === RESEND (EMAIL) ===
RESEND_API_KEY=

# === INNGEST ===
INNGEST_API_KEY=
INNGEST_EVENT_KEY=

# === SENTRY ===
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# === POSTHOG ===
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# === OPENAI (EMBEDDINGS ONLY) ===
OPENAI_API_KEY=

# === APP CONFIG ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# === STRIPE TEST MODE ===
STRIPE_MODE=test

# Legacy — no longer used. Leave empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
